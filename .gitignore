# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --- Data ---
# UCI dataset is small (2.4 MB) and redistributable, so we track it in-repo.
# Other raw folders (large downloads, private files) stay ignored.
data/raw/*
!data/raw/uci_grid/
!data/raw/uci_grid/**

# --- Trained models (regenerate via src/baselines.py / compliance_classifier.py) ---
models/*.pkl
models/**/*.pkl

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Office lock files (created while a .pptx/.docx/.xlsx is open) ---
~$*.pptx
~$*.docx
~$*.xlsx

# --- LaTeX build artefacts (if a paper/ dir is added later) ---
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
