# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --- Data ---
# UCI dataset is small (2.4 MB) and redistributable, so we track it in-repo.
# Other raw folders (large downloads, private files) stay ignored.
data/raw/*
!data/raw/uci_grid/
!data/raw/uci_grid/**

# Mesa Del Sol (Dryad doi:10.5061/dryad.fqz612jzb) - 15 monthly CSVs, ~467 MB
# total, belongs to that DOI. Cite it, don't redistribute it: download it
# yourself and drop the monthly file(s) here to re-run mesa_del_sol_validation.py.
data/external/mesa_del_sol/*.csv

# --- Trained models (regenerate via src/baselines.py / compliance_classifier.py / forecasting.py) ---
models/*.pkl
models/**/*.pkl
models/*.pt
models/**/*.pt

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Office lock files (created while a .pptx/.docx/.xlsx is open) ---
~$*.pptx
~$*.docx
~$*.xlsx

# --- LaTeX build artefacts (if a paper/ dir is added later) ---
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
